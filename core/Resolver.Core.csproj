<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Darkelle.Resolver.Core</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/central/**/*.cs"
             Exclude="../src/central/Initializer.cs;../src/central/value/DynValueConverter.cs;../src/central/logging/Godot*.cs;../src/central/security/DefaultExposedMethods.cs" />
    <ProjectReference Include="../generator/Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
